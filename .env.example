# Gemini key is used only on the server (Vercel env: GEMINI_API_KEY). Not needed in client .env for production.

# Optional: in local dev, point to your deployed app so /api calls work (e.g. https://your-app.vercel.app)
# VITE_API_ORIGIN=

# Supabase (optional – for backup/sync). Create project at https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
