# --- Gemini (for Capture reference outline/shading and Evaluate) ---
# Server-only. Never use VITE_GEMINI_API_KEY in production.
#
# Local dev – choose one:
#   A) Run "vercel dev" (not "npm run dev") and set GEMINI_API_KEY below so /api runs locally.
#   B) Use your deployed API: set VITE_API_ORIGIN to your Vercel app URL and set GEMINI_API_KEY on Vercel.
#
GEMINI_API_KEY=

# Optional: in local dev with "npm run dev", point to your deployed app so /api calls work
# VITE_API_ORIGIN=https://your-app.vercel.app

# --- Supabase (optional – for backup/sync). Create project at https://supabase.com ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
